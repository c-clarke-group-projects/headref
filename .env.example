# Copy to .env and fill in. Never commit .env. Never put a real value in this file.
#
# Lines starting with "# NAME=" are optional and use the built-in default. To change
# one, remove the "# " and give it a value. Never leave a number or a true/false
# setting blank: a blank value stops the app at startup.

APP_ENV=
LOG_LEVEL=
# API_PORT=

# Database (PostgreSQL 15 with psycopg3)
# Inside Docker: postgresql+psycopg://headref:headref@db:5432/headref
# On host machine: postgresql+psycopg://headref:headref@localhost:5432/headref
DATABASE_URL=
# DB_STATEMENT_TIMEOUT_MS=

# Legacy single-team sync (python -m app.sync). Must be present; may stay blank, since
# workspaces use the GitHub App and Atlassian OAuth below instead.
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# GitHub OAuth for Web Login (create in GitHub -> Developer Settings -> OAuth Apps).
# Callback URL: <host>/auth/github/callback. Needed to sign in at all.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Signs the session cookie. At least 32 characters, for example the output of
#   python -c "import secrets; print(secrets.token_hex(32))"
# Unset: a random key per process, so every restart signs everyone out.
SESSION_SECRET=

# headref GitHub App, read only, for workspace repositories (DEC-022).
# GitHub -> Settings -> Developer settings -> GitHub Apps. Read only: metadata, contents,
# pull requests, checks, commit statuses; no webhook. Setup URL:
# <host>/connections/github/setup. The private key is the .pem file GitHub generates,
# base64 encoded on 1 line:
#   python -c "import base64;print(base64.b64encode(open('key.pem','rb').read()).decode())"
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_B64=

# Atlassian OAuth 2.0 (3LO) app for workspace Jira connections (DEC-023).
# developer.atlassian.com -> Console -> OAuth 2.0 integration. Scopes read:jira-work,
# read:jira-user and offline_access; callback <host>/connections/jira/callback.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Encrypts stored connection tokens. Losing it means every Jira connection must be
# reconnected. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=


# Inference and Runtime (Ollama on host, DEC-017)
# Inside Docker: http://host.docker.internal:11434
# On host machine: http://localhost:11434
OLLAMA_URL=
MODEL_ID=
# OLLAMA_SEED=
# OLLAMA_NUM_PREDICT=
PROMPT_VERSION=

# Reliability & Networking
# HTTP_TIMEOUT_SECONDS=
# HTTP_MAX_ATTEMPTS=

# Thresholds (DATA_AND_EVIDENCE.md 6.8)
# FRESHNESS_WINDOW_HOURS=
# RECENT_ACTIVITY_DAYS=
# PR_REVIEW_WAIT_DAYS=
# DRAFT_PR_STALE_DAYS=
# ISSUE_NO_CODE_DAYS=
# DUE_SOON_DAYS=
# STATUS_STUCK_DAYS=
# NO_ACTIVITY_DAYS=
# EXCERPT_MAX_CHARS=
# MAX_EVIDENCE_ITEMS=

# Scheduler. Defaults: enabled, every 5 minutes, and a sync still "running" after
# 15 minutes is treated as stuck and marked failed.
# SYNC_INTERVAL_MINUTES=
# SCHEDULER_ENABLED=
# STUCK_SYNC_TIMEOUT_MINUTES=

# Ingestion scope. Comma separated. GITHUB_REPOS takes owner/repo entries,
# JIRA_PROJECT_KEYS takes project keys or the single value ALL.
GITHUB_REPOS=
JIRA_PROJECT_KEYS=

# Freshness display warnings
# FRESHNESS_WARN_MINUTES=
# FRESHNESS_STALE_MINUTES=
